# ==============================================================================
# JARBEES & PRODUCTOS CRUD - PLANTILLA DE ENTORNO (.env.example)
# ==============================================================================

# --- SERVIDOR Y ENTORNO ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# --- BASE DE DATOS (PostgreSQL con soporte pgvector) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jarbees_data?schema=public"

# --- AUTENTICACIÓN Y SEGURIDAD ---
JWT_SECRET="jarbees-secret-key-development-jwt-super-secure-token-2026"
CREDENTIALS_ENCRYPTION_KEY="jarbees-credentials-vault-aes256gcm-secret-key-2026"
ACTION_GATEKEEPER_SECRET="jarbees-action-gatekeeper-hmac-secret-key-2026"
MOBILE_GATEWAY_SECRET="jarbees-mobile-gateway-hmac-secret-key-2026"
MOBILE_GATEWAY_DISABLE_AUTH=false
SKIP_HITL=false
SKIP_QUARANTINE=false

# ==============================================================================
# OLLAMA & MODELOS DE IA POR CASO DE USO
# ==============================================================================
OLLAMA_HOST="http://localhost:11434"

# 1. MODELO ESTÁNDAR / GENERAL (Chatbot + Thinking unificado)
OLLAMA_MODEL_NAME="qwen3:8b"
OLLAMA_MODEL="qwen3:8b"

# 2. TRADUCTOR (Libros, PDFs y subtítulos .srt)
OLLAMA_TRADUCTOR_MODEL="RogerBen/hy-mt1.5-1.8b:latest"

# 3. VOZ & SÍNTESIS DE AUDIO (TTS)
OLLAMA_LECTOR_MODEL="sematre/orpheus:it_es-3b"
OLLAMA_TTS_MODEL="sematre/orpheus:it_es-3b"

# 4. LECTOR PRO / MODELOS DE PRUEBA (Traducción rápida y síntesis)
OLLAMA_MODEL_TEST4_NAME="gemma3:1b"
OLLAMA_MODEL_TEST5_NAME="gemma3:4b"

# 5. INTENT ROUTER / CLASIFICADOR (Sin modo thinking)
OLLAMA_MODEL_TEST2_NAME="llama3.2:3b"

# 6. TÉCNICO EXPERTO / CÓDIGO / RAG ESTRICTO
OLLAMA_CODER_MODEL="qwen2.5-coder:7b"
OLLAMA_MODEL_TEST3_NAME="qwen2.5-coder:7b"

# 6.5. RAZONAMIENTO PROFUNDO / DIALÉCTICA & CRUCE RAG
OLLAMA_REASONING_MODEL="qwen3:8b"

# 7. VISIÓN & MULTIMODAL (OCR / Imágenes)
OLLAMA_MODEL_VL_NAME="yemifo/qwen25-vl-3b-q4km:latest"

# 8. EMBEDDINGS VECTORIALES
OLLAMA_EMBEDDING_MODEL="bge-m3:latest"
OLLAMA_EMBEDDING_MODEL_FALLBACKS="nomic-embed-text:latest,all-minilm:latest"
EMBEDDING_DIM=1024

# ==============================================================================
# INTEGRACIONES Y SERVICIOS EXTERNOS (Opcionales)
# ==============================================================================
OPENROUTER_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/jarbees/google/callback"
# Zero-UI Mode: Configuración directa por backend (sin requerir login interactivo por front)
GOOGLE_REFRESH_TOKEN=""
GOOGLE_ACCESS_TOKEN=""
GOOGLE_SCOPES="https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/tasks"
YOUTUBE_API_KEY=""
